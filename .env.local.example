# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — put the real secrets there, never in this file.

# ---------------------------------------------------------------- database
#
# In the Supabase dashboard, open your project and click "Connect" at the top.
# You want the two URIs below. Both contain your database password, so treat
# them like passwords.
#
# DATABASE_URL  = the "Transaction pooler" URI  (port 6543)
#                 App queries. Pooled, so prepared statements are disabled.
#
# DIRECT_URL    = the "Direct connection" URI   (port 5432)
#                 Migrations only. DDL over the transaction pooler is unreliable.
#
# If the password shown is [YOUR-PASSWORD], reset it under
# Project Settings -> Database -> Database password, then paste the real one in.
# URL-encode any of : / ? # [ ] @ that appear in the password.

DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------ supabase api
#
# Project Settings -> API. Needed later for auth and file storage, not for
# the database work. The anon key is safe in the browser; the service role key
# bypasses every row-level security policy, so it must stay server-side only.

NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------ claude
#
# console.anthropic.com -> API keys. Used for resume parsing and tailoring.

ANTHROPIC_API_KEY=""
